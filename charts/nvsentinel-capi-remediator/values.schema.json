    "dryRun": {
      "type": "boolean"
    },
    "leaderElect": {
      "type": "boolean"
    },
    "restartFallback": {
      "type": "string",
      "enum": ["report", "replace"]
    },
    "pollInterval": {
      "type": "string"
    },
    "clusterSelector": {
      "type": "string"
    },
    "extraArgs": {
      "type": "array",
