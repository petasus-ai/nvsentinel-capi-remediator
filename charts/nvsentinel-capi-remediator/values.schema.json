{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dryRun": {
      "type": "boolean"
    },
    "leaderElect": {
      "type": "boolean"
    },
    "restartFallback": {
      "type": "string",
      "enum": ["report", "replace"]
    },
    "decisions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[^,=\\s]+$"
      },
      "additionalProperties": {
        "type": "string",
        "enum": ["report", "restart", "replace"]
      }
    },
    "deviceQuarantine": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
          }
        }
      }
    },
    "pollInterval": {
      "type": "string",
      "pattern": "^(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|\u00b5s|\u03bcs|ms|s|m|h))+$"
    },
    "clusterSelector": {
      "type": "string"
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
